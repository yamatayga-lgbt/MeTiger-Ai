# MeTiger Ai — переменные окружения
# Скопируйте в .env и заполните значениями (файл .env не публикуется).

# Переменные бота не нужны: с 0.036 вход один — сайт. Ключ бота лежит в
# keys/.secrets.env и не удалён на случай, если бота решат вернуть.

# Backend: ключи моделей (обсуждаем отдельно)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
