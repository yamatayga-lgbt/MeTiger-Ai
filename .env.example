# MeTiger Ai — переменные окружения
# Скопируйте в .env и заполните значениями (файл .env не публикуется).

# Telegram Bot API token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# Backend: ключи моделей (обсуждаем отдельно)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Секрет для проверки initData Telegram WebApp
WEBAPP_SECRET=
