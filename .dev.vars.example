# Локальные ключи движка (копировать в .dev.vars; сам файл в git не попадает).
# Формат — как у Cloudflare: одна переменная на строку.
#
# Один провайдер уже делает MeTiger живым; несколько — потому что бесплатный
# пул держится на обходе: где 429, где отказ, где обрыв на середине фразы.
GROQ_KEYS=
GEMINI_KEYS=
CLOUDFLARE_KEYS=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_KEYS=
MISTRAL_KEYS=
ZAI_KEYS=
ODIROUTER_KEYS=
# Своя железка (Ollama / llama.cpp / LM Studio) — факультативно, в конце очереди
LOCAL_BASE_URL=
LOCAL_MODELS=
LOCAL_KEY=
# На prod это ставится секретом Pages: wrangler pages secret put GROQ_KEYS

# Память чата и общий слой лимитов. В проде это KV-байндинг MEMORY (Pages →
# Settings → Functions → KV namespace bindings); локально его подставляет
# scripts/api-dev.js файловым хранилищем .mt-memory, поэтому ничего включать не надо.
# SHARED_LIMITS=0 — вернуть лимиты «только в изоляторе» (было так до общего слоя).
#SHARED_LIMITS=1
#RATE_MAX=12
#RATE_WINDOW_MS=60000
#RATE_PROBE_AT=3
#SHARED_WRITE_MS=60000
#QUAR_TTL_MAX=3600
